{
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "platform",
          "Version": "v1"
        }
      },
      "orders": {
        "ClusterId": "orders",
        "Order": 2,
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "orders",
          "Version": "v1"
        }
      },
      "payments": {
        "ClusterId": "orders",
        "Order": 2,
        "Match": { "Path": "/api/payments/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "orders",
          "Version": "v1"
        }
      },
      "promocodes": {
        "ClusterId": "orders",
        "Order": 2,
        "Match": { "Path": "/api/promocodes/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "orders",
          "Version": "v1"
        }
      },
      "catalog": {
        "ClusterId": "catalog",
        "Order": 2,
        "Match": { "Path": "/api/products/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        }
      },
      "stock": {
        "ClusterId": "catalog",
        "Order": 2,
        "Match": { "Path": "/api/stock/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        }
      },
      "reviews": {
        "ClusterId": "reviews",
        "Order": 2,
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "reviews",
          "Version": "v1"
        }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": { "ActivityTimeout": "00:01:00" },
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "orders": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "d1": { "Address": "http://orders-api" } }
      },
      "catalog": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "d1": { "Address": "http://catalog-api" } }
      },
      "reviews": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "d1": { "Address": "http://reviews-api" } }
      }
    }
  }
}